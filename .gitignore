# Virtual env
.venv/

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Data / outputs (tweak if needed)
output/
**/output/
# Ignore DB contents, not the directory itself: git cannot re-include a file whose
# parent directory is excluded, and predictions.duckdb below needs to be tracked.
db/*
**/db/*
# The product record — the calls we published each week. Tracked deliberately: it is the
# only copy, nothing syncs it, and unlike prices/earnings a lost week cannot be refetched.
!db/predictions.duckdb
backtesting/artifacts/
testing/testing_results/
testing/testing_results/**

# Contains real subscriber emails - never track
data/subscribers.txt

# misc stuff
.DS_Store
.env
*.env
.ipynb_checkpoints/
temp.py