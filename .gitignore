# Virtual env
.venv/

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Data / outputs (tweak if needed)
output/
**/output/
# Ignore DB contents, not the directory itself: git cannot re-include a file whose
# parent directory is excluded, and predictions.duckdb below needs to be tracked.
db/*
**/db/*
# The product record — the calls we published each week. Tracked deliberately: it is the
# only copy, nothing syncs it, and unlike prices/earnings a lost week cannot be refetched.
!db/predictions.duckdb
backtesting/artifacts/
testing/testing_results/
testing/testing_results/**
data/subscribers.txt
data/benzinga_earnings/**
data/benzinga_features/**

# misc stuff
.DS_Store
.env
*.env
.ipynb_checkpoints/
temp.py
# Phase 1 parity scaffolding: a full pre-change copy of the daily frame (309 MB). The
# parity procedure lives in the archive tag methodology-audit-archive-october-2026; this
# line stays only while a local copy of the file still exists.
audit/phase1_golden/daily_df_pre.parquet

# Raw + normalized third-party vendor data (Massive / Benzinga, SEC, options). Licensed
# data in a public repo, and nothing under here may ever become a production input — see
# the static guards in testing/test_production_guards.py.
data/vendor/
**/vendor/

# Benzinga acquisition tooling and its vendor data. Same rule as vendor/ above: licensed
# third-party data must not land in a public repo. The tooling is archived in the tag
# methodology-audit-archive-october-2026, not part of the product.
benzinga_tools/
benzinga_integration/
benzinga_features/
data/benzinga_earnings/
data/benzinga_features/
